@startuml
title ER - Distribution
hide circle
entity shipments {
  * id : uuid <<PK>>
  --
  restock_request_id : uuid <<UK>>
  warehouse_id : uuid
  retail_id : uuid
  courier_id : uuid
  status : enum(CREATED,SHIPPED,DELIVERED,FAILED)
  shipped_at : timestamp
  delivered_at : timestamp
  created_at : timestamp
}
entity shipment_items {
  * id : uuid <<PK>>
  --
  shipment_id : uuid <<FK>>
  commodity_id : uuid
  quantity : int
}
entity shipment_trackings {
  * id : uuid <<PK>>
  --
  shipment_id : uuid <<FK>>
  status : enum
  note : text
  created_by : uuid
  created_at : timestamp
}
shipments ||--|{ shipment_items
shipments ||--o{ shipment_trackings
@enduml
