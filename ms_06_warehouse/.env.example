DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_warehouse
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Use long, random values. Each role has a separate bearer token.
OWNER_TOKEN=replace-with-a-long-random-owner-token
WAREHOUSE_MANAGER_TOKEN=replace-with-a-long-random-manager-token
EVENT_CONSUMER_TOKEN=replace-with-a-long-random-event-token

# URL of the event gateway/broker adapter that accepts the documented JSON envelope.
EVENT_PUBLISH_URL=https://events.example.test/publish
EVENT_PUBLISH_TOKEN=
OUTBOX_BATCH_SIZE=20
